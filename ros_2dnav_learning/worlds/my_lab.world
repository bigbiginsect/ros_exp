<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="my_lab">
    <!-- Gravity, physics default omitted for brevity -->

    <!-- Ground plane -->
    <include><uri>model://ground_plane</uri></include>

    <!-- Four walls forming 5m x 3m rectangle.
         Walls are thin boxes; origin at (0,0). -->
    <!-- wall thickness and height -->
    <model name="wall_north">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>5 0.1 1.0</size></box></geometry>
          <pose>0 1.5 0.5 0 0 0</pose>
        </collision>
        <visual name="visual">
          <geometry><box><size>5 0.1 1.0</size></box></geometry>
          <pose>0 1.5 0.5 0 0 0</pose>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>5 0.1 1.0</size></box></geometry>
          <pose>0 -1.5 0.5 0 0 0</pose>
        </collision>
        <visual name="visual">
          <geometry><box><size>5 0.1 1.0</size></box></geometry>
          <pose>0 -1.5 0.5 0 0 0</pose>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 3 1.0</size></box></geometry>
          <pose>2.5 0 0.5 0 0 0</pose>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 3 1.0</size></box></geometry>
          <pose>2.5 0 0.5 0 0 0</pose>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 3 1.0</size></box></geometry>
          <pose>-2.5 0 0.5 0 0 0</pose>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 3 1.0</size></box></geometry>
          <pose>-2.5 0 0.5 0 0 0</pose>
        </visual>
      </link>
    </model>

    <!-- 两个障碍：盒子（都比常见差速机器人大） -->
    <model name="obstacle_big1">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.8 0.8 0.8</size></box></geometry>
          <pose>-0.5 0.6 0.4 0 0 0</pose>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.8 0.8</size></box></geometry>
          <pose>-0.5 0.6 0.4 0 0 0</pose>
        </visual>
      </link>
    </model>

    <model name="obstacle_big2">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 0.4 0.8</size></box></geometry>
          <pose>0.8 -0.4 0.4 0 0 0</pose>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.4 0.8</size></box></geometry>
          <pose>0.8 -0.4 0.4 0 0 0</pose>
        </visual>
      </link>
    </model>

  </world>
</sdf>
